# Server-only Gemini configuration for /api/image-search. Never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_IMAGE_SEARCH_MODEL=gemini-3.5-flash-lite
# Per-process photo-search limits. Daily counters reset at midnight UTC or restart.
IMAGE_SEARCH_PER_IP_MINUTE=3
IMAGE_SEARCH_PER_IP_DAY=10
IMAGE_SEARCH_DAILY_LIMIT=100
