{
  "name": "@dtc/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "start:cases": "cross-env SITE=cases next start -p 3000",
    "start:eyewear": "cross-env SITE=eyewear next start -p 3001",
    "start:toys": "cross-env SITE=toys next start -p 3002",
    "start:watches": "cross-env SITE=watches next start -p 3003",
    "sites": "npm run clean && npm run build && concurrently -n cases,eyewear,toys,watches -c blue,green,magenta,yellow \"npm:start:cases\" \"npm:start:eyewear\" \"npm:start:toys\" \"npm:start:watches\"",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "tryon:miu:regenerate": "node scripts/generate-victor-tryon.mjs --force --handles sun-miu-miu-mu-11ws,sun-miu-miu-mu-11zs,sun-miu-miu-mu-56zs,sun-miu-miu-mu-a03s,sun-miu-miu-mu-09ws,sun-miu-miu-mu-a04s,sun-miu-miu-mu-a06s,sun-miu-miu-mu-01zs,sun-miu-miu-mu-04zs,sun-miu-miu-miu-regard,sun-miu-miu-mu-a07s,sun-miu-miu-mu-a08s,sun-miu-miu-mu-a09s,sun-miu-miu-mu-b01s,sun-miu-miu-mu-b06s",
    "tryon:miu:regenerate:male": "node scripts/generate-victor-tryon.mjs --force --outdir worn-victor-male --portrait apps/storefront/scripts/assets/male-model-black-shirt-texture-preserved.png --pronoun his --handles sun-miu-miu-mu-11ws,sun-miu-miu-mu-11zs,sun-miu-miu-mu-56zs,sun-miu-miu-mu-a03s,sun-miu-miu-mu-09ws,sun-miu-miu-mu-a04s,sun-miu-miu-mu-a06s,sun-miu-miu-mu-01zs,sun-miu-miu-mu-04zs,sun-miu-miu-miu-regard,sun-miu-miu-mu-a07s,sun-miu-miu-mu-a08s,sun-miu-miu-mu-a09s,sun-miu-miu-mu-b01s,sun-miu-miu-mu-b06s"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.20.1",
    "@medusajs/types": "2.20.1",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^5.10.0",
    "motion": "^11.18.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
