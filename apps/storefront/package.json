{
  "name": "@dtc/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "start:cases": "cross-env SITE=cases next start -p 3000",
    "start:eyewear": "cross-env SITE=eyewear next start -p 3001",
    "start:toys": "cross-env SITE=toys next start -p 3002",
    "sites": "npm run build && concurrently -n cases,eyewear,toys -c blue,green,magenta \"npm:start:cases\" \"npm:start:eyewear\" \"npm:start:toys\"",
    "lint": "eslint",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@medusajs/js-sdk": "2.20.1",
    "@medusajs/types": "2.20.1",
    "@stripe/stripe-js": "^5.10.0",
    "@stripe/react-stripe-js": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
