# ─────────────────────────────────────────────────────────────
# Shared infra (docker-compose)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# Medusa backend (apps/medusa/.env)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-in-dev
COOKIE_SECRET=replace-me-in-dev
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:9000,http://localhost:7001,http://localhost:8000

# worker | server | shared
MEDUSA_WORKER_MODE=shared

# Encryption key for supplier credentials (32 bytes hex = 64 chars)
SUPPLIER_SECRET_KEY=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=orders@example.com

# Telegram ops alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Object storage (MinIO in dev / R2 in prod)
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=medusa-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FILE_URL=http://localhost:9002/medusa-media

# Storefront -> Medusa
MEDUSA_BACKEND_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────
# Storefront (apps/storefront/.env.local)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# One publishable key per sales channel / niche
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY_CASES=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY_EYEWEAR=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY_TOYS=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY_WATCHES=
# Active niche for this deploy: cases | eyewear | toys
SITE=cases
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_GA_MEASUREMENT_ID=
REVALIDATE_SECRET=replace-me-in-dev
# Public origin that serves legacy relative product images (for example, /images/eyewear/*)
LUXESHADE_STOREFRONT_URL=https://luxshade.up.railway.app
